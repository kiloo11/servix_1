{
  "name": "servix",
  "version": "1.3.0",
  "description": "Учет серверов, доменов и сертификатов с Telegram-уведомлениями.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web install && npm --prefix web run build",
    "server": "node --env-file-if-exists=.env server.js",
    "dev:server": "DATA_DIR=./.devdata SEED_DEMO_DATA=true node --env-file-if-exists=.env server.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
